# Подпись сессионных куки — обязательно поменяйте в проде
AUTH_SECRET=change-me

# Публичный адрес сервиса — ОБЯЗАТЕЛЕН за nginx/прокси и в проде.
# Без него OAuth-редиректы уходят на localhost. Без слэша в конце.
# Локально можно не задавать (возьмётся из запроса).
APP_URL=https://seo.example.ru

# «Войти через Яндекс» (Метрика + Вебмастер).
# Создайте приложение на https://oauth.yandex.ru:
#   Права: «Яндекс.Метрика — получение статистики», «Яндекс.Вебмастер — чтение»
#   Redirect URI: http://localhost:3000/api/oauth/yandex/callback (плюс прод-домен)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# «Войти через Google» (Search Console, только чтение).
# Google Cloud Console → APIs & Services:
#   включите Search Console API, создайте OAuth client (Web application)
#   Authorized redirect URI: http://localhost:3000/api/oauth/google/callback (плюс прод-домен)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
